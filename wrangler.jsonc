{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coss-work",
	"main": "app/router.ts",
	"assets": { "directory": "dist/client" },
	"compatibility_date": "2026-04-02",
	"compatibility_flags": ["nodejs_compat"],
	// OpenPanel. The client id is shipped to the browser, so these are plain
	// vars, not secrets. Either one empty means no analytics script is rendered,
	// which keeps local dev out of the dashboard. The api url is the self-hosted
	// instance plus /api, e.g. "https://analytics.example.com/api".
	"vars": {
		"OPENPANEL_CLIENT_ID": "0b65c130-41c7-4f33-b316-c5587ea9815b",
		"OPENPANEL_API_URL": "https://op.aurelius.ink/api",
	},
}
